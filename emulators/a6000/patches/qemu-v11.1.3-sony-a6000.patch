diff --git a/hw/misc/cxd90014_adc.c b/hw/misc/cxd90014_adc.c
index 8616085..e65d2bf 100644
--- a/hw/misc/cxd90014_adc.c
+++ b/hw/misc/cxd90014_adc.c
@@ -8,6 +8,11 @@
  * its input.ko ADC key ranges all end at or below 0x304, so 1023 reads
  * as "released" there too (E0526).
  *
+ * Per-channel idle levels (cxd90014_adc_set_idle / cxd90014_adc_idle,
+ * default 1023) come from voxivoid/a6000-qemu (commit 62cf3bc): the
+ * ILCE-6000 mode dial sits on ADC ladders whose rest level is a dial
+ * position, not "released".
+ *
  * Original description (a5000):
  * From av-cam.bin (docs/RE_AVCAM_IRQ_BOOT.md, 0x4391722c result reader):
  *   +0x00 channel mask   +0x04 bit0 start   +0x08 mode (2 = continuous [?])
@@ -36,6 +41,9 @@ struct AdcState {
     MemoryRegion mr;
     uint32_t reg[0x100 / 4];
     uint16_t result[12];
+    /* sony-a6000: released level per channel (voxivoid/a6000-qemu) */
+    uint16_t idle[12];
+    bool idle_set;
     QEMUTimer *t;
     qemu_irq irq;
 };
@@ -99,12 +107,39 @@ void cxd90014_adc_set(DeviceState *dev, int ch, uint16_t level)
     }
 }
 
+/*
+ * Idle (released) level of a channel, kept across resets (sony-a6000, from
+ * voxivoid/a6000-qemu).  Default 1023; a position-type input such as the
+ * A6000 mode dial (two ladders, one of them inside a band at every dial
+ * position) sets it to the band it rests in.
+ */
+void cxd90014_adc_set_idle(DeviceState *dev, int ch, uint16_t level)
+{
+    AdcState *s = CXD_ADC(dev);
+    if (!s->idle_set) {
+        for (int i = 0; i < 12; i++) {
+            s->idle[i] = 1023;
+        }
+        s->idle_set = true;
+    }
+    if (ch >= 0 && ch < 12) {
+        s->idle[ch] = level & 0x3ff;
+        s->result[ch] = s->idle[ch];
+    }
+}
+
+uint16_t cxd90014_adc_idle(DeviceState *dev, int ch)
+{
+    AdcState *s = CXD_ADC(dev);
+    return s->idle_set && ch >= 0 && ch < 12 ? s->idle[ch] : 1023;
+}
+
 static void adc_reset(DeviceState *dev)
 {
     AdcState *s = CXD_ADC(dev);
     memset(s->reg, 0, sizeof(s->reg));
     for (int i = 0; i < 12; i++) {
-        s->result[i] = 1023;
+        s->result[i] = s->idle_set ? s->idle[i] : 1023;
     }
     timer_del(s->t);
 }
