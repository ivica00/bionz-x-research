          ((s->norintsts & SDHC_NIS_REMOVE) && (s->wakcon & SDHC_WKUP_ON_RMV));
 }
 
+/*
+ * SDIO card interrupt: level-sensitive status bit, follows the card's line
+ * while enabled in NORINTSTSEN, cannot be cleared by a W1C write.
+ */
+static void sdhci_update_cardint(SDHCIState *s)
+{
+    if (s->card_irq && (s->norintstsen & SDHC_NISEN_CARDINT)) {
+        s->norintsts |= SDHC_NIS_CARDINT;
+    } else {
+        s->norintsts &= ~SDHC_NIS_CARDINT;
+    }
+}
+
 /* Return true if IRQ was pending and delivered */
 static bool sdhci_update_irq(SDHCIState *s)
 {
-    bool pending = sdhci_slotint(s);
+    bool pending;
+
+    sdhci_update_cardint(s);
+    pending = sdhci_slotint(s);
 
     qemu_set_irq(s->irq, pending);
 
@@ -270,6 +286,14 @@ static void sdhci_set_inserted(DeviceState *dev, bool level)
     }
 }
 
+static void sdhci_set_card_irq(DeviceState *dev, bool level)
+{
+    SDHCIState *s = (SDHCIState *)dev;
+
+    s->card_irq = level;
+    sdhci_update_irq(s);
+}
+
 static void sdhci_set_readonly(DeviceState *dev, bool level)
 {
     SDHCIState *s = (SDHCIState *)dev;
